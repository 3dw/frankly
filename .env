# Firebase 設定（使用 emulator）
FIREBASE_PROJECT_ID=dev
FUNCTIONS_URL_PREFIX=http://127.0.0.1:5001/dev/us-central1
FIREBASE_DATABASE_URL=http://127.0.0.1:9000

# Cloudinary 設定（可選）
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_IMAGE_PRESET=frankly-image-default
CLOUDINARY_VIDEO_PRESET=frankly-video-default
CLOUDINARY_DEFAULT_PRESET=frankly-video-default

# 啟用 emulator
EMULATORS=functions,firestore,auth,database